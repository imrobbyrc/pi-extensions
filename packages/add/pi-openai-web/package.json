{
  "name": "@imrobbyrc/pi-openai-web",
  "version": "1.0.1",
  "private": true,
  "description": "Pi-native harness: always-on ChatGPT Web Lead Architect with strict bounded lead tools and Herdr-managed Pi workers.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "chatgpt",
    "mcp",
    "herdr"
  ],
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-openai-web/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "doctor": "tsx scripts/doctor.ts",
    "browser": "tsx scripts/start-browser.ts",
    "chrome": "PLANNER_BROWSER=chrome tsx scripts/start-browser.ts",
    "gui": "tsx scripts/demo-orchestrator-gui.ts"
  },
  "dependencies": {
    "@imrobbyrc/pi-core-subagent": "file:../../core/pi-core-subagent",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "chrome-remote-interface": "^0.33.3",
    "fastify": "^5.6.0",
    "tiktoken": "^1.0.22",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/chrome-remote-interface": "^0.34.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typebox": "^1.3.32",
    "typescript": "^6.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "files": [
    "extensions/",
    "src/",
    "browser-extension/",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ]
}
